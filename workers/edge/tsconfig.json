{
  // The Worker stays plain JS and is CHECKED as JS (ADR-0004 addendum,
  // 2026-09-25): `checkJs` here rather than a per-file `// @ts-check`, so a
  // new file cannot opt out by omission. Runtime + binding types come from
  // wrangler's generated cloudflare-env.d.ts (`pnpm run cf-typegen`; gitignored,
  // regenerated by the typecheck script), never from @cloudflare/workers-types.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.js", "cloudflare-env.d.ts"]
}
