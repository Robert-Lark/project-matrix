# build output (the client's public tree nests under dist/qwik/ because of
# vite's `base` — see wrangler.jsonc)
dist/

# the SSR build's output. Deliberately NOT inside dist/: dist/ IS this
# Worker's public asset directory, so a server bundle written there would be
# downloadable. wrangler bundles it via dist/_worker.js's relative import.
server/

# tsc's outDir (noEmit, but tsconfig names it) + incremental state
tmp/
*.tsbuildinfo

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler dev state
.wrangler/

# --- editorial-build slice D additions (generated, never source) ---

# @pm/tokens copied in by scripts/prepare-build.mjs before every build. Vite
# copies public/ verbatim into the client's public output, which is what
# ADR-0003 §8 requires: the font files must arrive byte-identical to the
# @pm/tokens sources and the canonical loading markup must ship as written.
public/assets/pm/
