// The Remix 3 fenced frontier exhibit: a hand-rolled Workers entry
// (editorial-build slice F; ADR-0004 second addendum — Remix 3 has NO
// official Workers deployment target, and the spike proved the full render
// path runs on workerd with no compat flags; the ~20-line entry in
// src/worker.ts IS the whole "adapter"). Trays are fetched through the edge
// Worker at REQUEST time (ADR-0002 §7) — the front Worker's own EDGE binding
// doesn't reach a variant server-side, so this Worker binds pm-edge itself
// (the slice-B precedent).
//
// Assets (the shared css/fonts, the prebuilt client runtime, the plaque/demo
// stylesheet, the cart enhancement) are nested under dist/remix3/ and served
// assets-first; only non-asset paths reach the script. No `binding` under
// `assets`: nothing in this Worker's own code fetches the asset layer (the
// htmx precedent).
//
// Deliberately NO nodejs_compat flag — the spike's verified claim is that
// the pinned beta's core render path is web-standard; if a future pin bump
// ever needs the flag, that fact belongs in DIFF-TO-STARTER.md and the
// spike's FINDINGS.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pm-remix3",
  "main": "src/worker.ts",
  // The plane's shared date: the runtime compatibility date changes runtime
  // semantics, so a per-variant value would be an unfair variable across the
  // matrix (ADR-0003). The fence excludes numbers, not the fairness posture.
  "compatibility_date": "2026-06-01",
  "workers_dev": false, // reachable ONLY through pm-front's service binding
  "assets": {
    "directory": "./dist"
  },
  "services": [{ "binding": "EDGE", "service": "pm-edge" }],
  "observability": {
    "enabled": true
  }
}
