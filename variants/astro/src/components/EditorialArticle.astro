---
/**
 * The editorial article — canonical markup (the contract of record is
 * `packages/reference/surfaces/editorial/index.html`, generated by
 * `packages/reference/render/editorial.mjs`).
 *
 * Prose plus exactly ONE interaction: the featured release's Add to cart. The
 * button is served plain and inert; the enhancement that gives it behavior is
 * the paradigm's own (see `src/scripts/cart.ts`), so with JS off this page
 * states nothing false — the copy below already frames the button as the only
 * interactive element.
 */
import type { EditorialData } from "../lib/data";
import { essayFor } from "../lib/essays";
import ReleaseCard from "./ReleaseCard.astro";

interface Props {
  data: EditorialData;
}

const { data } = Astro.props;
const { featured, summary, capturedAt } = data;
const essay = essayFor(data.name);

/**
 * The prose blocks, with the one figure inserted after the opening paragraph
 * (the contract of record's own position). The figure prefers the second image
 * when the tray carries one, exactly as the master does.
 */
const figureImg = featured.images[1] ?? featured.images[0]!;
const label = featured.labels[0];
/** The catalogue number is appended only when the tray carries one. */
const catno = label?.catno ? ` · ${label.catno}` : "";
const blocks = essay.body(featured);
---

<article class="pm-editorial">
  <header class="pm-editorial__head">
    <p class="pm-page__kicker">{essay.kicker}</p>
    <h1 class="pm-editorial__title">{essay.title}</h1>
    <p class="pm-editorial__dek">{essay.dek}</p>
    <p class="pm-editorial__dateline">From the crate · frozen <time datetime={capturedAt}>{capturedAt}</time></p>
  </header>
  <div class="pm-prose">
    <p set:html={blocks[0]!.html} />
    <figure><img src={figureImg.src} width={figureImg.width} height={figureImg.height} alt={figureImg.alt} loading="lazy" decoding="async" /><figcaption>{featured.artist} — {featured.title} ({label?.name ?? ""}{catno}), from the frozen snapshot.</figcaption></figure>
    {blocks.slice(1).map((block) =>
      block.kind === "blockquote" ? (
        <blockquote><p set:html={block.html} /></blockquote>
      ) : (
        <p set:html={block.html} />
      ),
    )}
  </div>
  <aside class="pm-editorial__feature" aria-label="Featured release">
    <ul class="pm-grid" role="list">
      <ReleaseCard summary={summary} />
    </ul>
    <div class="pm-editorial__feature-body">
      <p class="pm-editorial__feature-note">{essay.featureNote}</p>
      <div><button class="pm-button" type="button" disabled={summary.numForSale === 0}>Add to cart</button></div>
      <p class="pm-editorial__feature-note">The only interactive element on this page — that's the experiment.</p>
    </div>
  </aside>
</article>
