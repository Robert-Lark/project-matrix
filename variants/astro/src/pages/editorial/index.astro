---
/**
 * /astro/editorial/ — the islands paradigm on the render baseline.
 *
 * The page is thin on purpose: the snapshot was already resolved and baked by
 * `scripts/prepare-build.mjs` (build-time is this paradigm's real shape on this
 * surface, ADR-0002 §7), so all this route does is hand the baked payload to
 * the one render entry point. Nothing here runs per request — there is no
 * server at request time, only Workers Static Assets.
 */
import type { EditorialData } from "../../lib/data";
import baked from "../../data/snapshot.json";
import EditorialDocument from "../../components/EditorialDocument.astro";

const data = baked as EditorialData;
---

<EditorialDocument data={data} />
