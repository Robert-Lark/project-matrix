{
  "name": "@pm/astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The astro variant (editorial-build slice C): the islands paradigm, static output with no adapter. Snapshot-parameterized build (PM_SNAPSHOT: fixture default, crate on deploy) bakes the trays at build time; serves /astro/* through the composed origin.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/prepare-build.mjs && astro build",
    "dev": "wrangler dev --port 8794 --inspector-port 9237",
    "deploy": "wrangler deploy",
    "typecheck": "astro check",
    "test": "vitest run",
    "astro": "astro"
  },
  "dependencies": {
    "@pm/data-contract": "workspace:*",
    "@pm/tokens": "workspace:*",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pm/drift-gate": "workspace:*",
    "linkedom": "^0.18.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
